# External URL (for public access)
# Set this to your external IP or domain
EXTERNAL_URL=http://202.239.243.68:8000
PUBLIC_BASE_URL=https://upload.example.com

# HTTP server configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
HTTP_LISTING_PORT=8004
HTTP_LOGIN_PORT=8080

# Server startup flags
ENABLE_UPLOAD_SERVER=1
ENABLE_LISTING_SERVER=1

# Upload limits in bytes
MAX_UPLOAD_BYTES=5368709120
MAX_IP_STORAGE_BYTES=85899345920

# Listing authentication
LISTING_USERNAME=admin
LISTING_PASSWORD=change_me
LISTING_SESSION_SECRET=change_me
